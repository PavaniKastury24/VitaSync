# ==========================================
# VitaSync Root Environment Reference
# Note: Specific services use frontend/.env.local and backend/.env
# ==========================================

# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-backend-verification

# Database Connection (Direct or Pooled PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# Google Gemini AI Configuration
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# API Network Settings
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=3000
